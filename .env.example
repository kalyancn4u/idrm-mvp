# --- App ----------------------------------------------------------------------
APP_ENV=development
APP_NAME=IDRM
APP_TAGLINE=Integrated Disaster Response Management
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5000

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://idrm_user:idrm_pass@127.0.0.1:5432/idrm_db
DATABASE_URL_SYNC=postgresql+psycopg2://idrm_user:idrm_pass@127.0.0.1:5432/idrm_db

# --- Redis (optional — leave blank to disable) --------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=

# --- JWT (RS256) --------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# ---- Access token TTLs (minutes) with jitter --------------------------------
JWT_ACCESS_TTL_CITIZEN_MIN=120
JWT_ACCESS_TTL_VOLUNTEER_MIN=120
JWT_ACCESS_TTL_PROVIDER_MIN=120
JWT_ACCESS_TTL_COORDINATOR_MIN=60
JWT_ACCESS_TTL_ADMIN_MIN=30

JWT_ACCESS_JITTER_CITIZEN_MIN=20
JWT_ACCESS_JITTER_VOLUNTEER_MIN=20
JWT_ACCESS_JITTER_PROVIDER_MIN=20
JWT_ACCESS_JITTER_COORDINATOR_MIN=10
JWT_ACCESS_JITTER_ADMIN_MIN=5

# ---- Refresh token TTLs (days, sliding) with jitter -------------------------
JWT_REFRESH_TTL_CITIZEN_DAYS=180
JWT_REFRESH_TTL_VOLUNTEER_DAYS=180
JWT_REFRESH_TTL_PROVIDER_DAYS=180
JWT_REFRESH_TTL_COORDINATOR_DAYS=90
JWT_REFRESH_TTL_ADMIN_DAYS=30

JWT_REFRESH_JITTER_CITIZEN_DAYS=7
JWT_REFRESH_JITTER_VOLUNTEER_DAYS=7
JWT_REFRESH_JITTER_PROVIDER_DAYS=7
JWT_REFRESH_JITTER_COORDINATOR_DAYS=5
JWT_REFRESH_JITTER_ADMIN_DAYS=3

# ---- Session limits / idle timeouts -----------------------------------------
SESSION_LIMIT_CITIZEN=2
SESSION_LIMIT_VOLUNTEER=3
SESSION_LIMIT_PROVIDER=3
SESSION_LIMIT_COORDINATOR=3
SESSION_LIMIT_ADMIN=2

SESSION_IDLE_CITIZEN_HOURS=2160
SESSION_IDLE_VOLUNTEER_HOURS=2160
SESSION_IDLE_PROVIDER_HOURS=2160
SESSION_IDLE_COORDINATOR_HOURS=12
SESSION_IDLE_ADMIN_HOURS=4

SESSION_CACHE_TTL_SECONDS=60

# ---- Auto-approval ----------------------------------------------------------
AUTO_APPROVAL_ENABLED=1

# ---- Object storage ---------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=idrm-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- Flask dashboard --------------------------------------------------------
DASHBOARD_SECRET_KEY=change-me-dashboard-openssl-rand-hex-32
DASHBOARD_SESSION_COOKIE_SECURE=0
DASHBOARD_SESSION_LIFETIME_MINUTES=480
DASHBOARD_ALLOWED_ROLES=coordinator,admin

# ---- First admin account ----------------------------------------------------
# Password given to admin@idrm.local when migration 0003 first creates it.
# Left empty, development uses the public demo password; with
# APP_ENV=production the migration refuses to run until this is set (12+ chars).
ADMIN_INITIAL_PASSWORD=

# ---- Reverse proxy ----------------------------------------------------------
# 1 only if a proxy you control overwrites X-Forwarded-For. Used for rate
# limiting and audit; a wrong "1" lets callers fake their address.
TRUST_FORWARDED_FOR=0

# ---- Seed -------------------------------------------------------------------
SEED_PASSWORD=IDRMseed#2026
