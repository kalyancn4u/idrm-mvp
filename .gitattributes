# =============================================================================
#  IDRM MVP — git attributes
#  Normalises line endings and marks binary files.
#
#  Why: the code runs on Linux. A shell script or Makefile checked out with
#  Windows line endings (CRLF) fails there ("bad interpreter: /bin/bash^M",
#  "missing separator"). `eol=lf` makes every checkout use LF, on every
#  operating system, whatever the user's core.autocrlf setting says.
#
#  This file must sit at the repository ROOT: git applies a .gitattributes
#  only to the directory it is in and below. (Until 2026-11-25 it was in
#  docs/ by mistake and protected only the documentation. PENDING-TASKS H-2.)
# =============================================================================

# ---- Default: normalise line endings to LF in the repo and on checkout ------
* text=auto eol=lf

# ---- Windows-only scripts need CRLF (none exist yet) -------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---- Explicit text types ----------------------------------------------------
*.py       text diff=python
*.pyi      text diff=python
*.sql      text diff=sql
*.sh       text eol=lf
*.bash     text eol=lf
*.yml      text
*.yaml     text
*.json     text
*.toml     text
*.ini      text
*.cfg      text
*.md       text
*.html     text
*.css      text
*.js       text
*.mako     text

# ---- Makefile: tabs are significant -----------------------------------------
Makefile   text eol=lf
*.mk       text eol=lf

# ---- Binary files -----------------------------------------------------------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      text
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary

# ---- Lock files — hide from diffs -------------------------------------------
*.lock     -diff
poetry.lock -diff

# ---- Language statistics — vendored code doesn't count ----------------------
.venv/**   linguist-vendored
node_modules/** linguist-vendored

# ---- GitHub: render these as specific languages -----------------------------
*.mako     linguist-language=Python
